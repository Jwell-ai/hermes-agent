HERMES_AGENT_HOST=0.0.0.0
HERMES_AGENT_PORT=58088
# Shared secret used by Alphart backend callbacks and /internal relay calls.
HERMES_AGENT_TOKEN=
HERMES_AGENT_MAX_ITERATIONS=30
ALPHART_AGENT_GAME_MAX_TOKENS=32768
ALPHART_EDU_BACKEND_URL=http://alphart-edu:57988
ALPHART_CANVAS_BACKEND_URL=http://host.docker.internal:9999
ALPHART_BACKEND_TOOL_TIMEOUT_SECONDS=900

# Public game artifact bucket. The bucket is public-read, but writes still use
# authenticated S3 credentials from the agent.
ALPHART_EDU_S3_ENDPOINT=
ALPHART_EDU_S3_REGION=us-east-1
ALPHART_EDU_S3_PUBLIC_BUCKET=
ALPHART_EDU_S3_ACCESS_KEY_ID=
ALPHART_EDU_S3_SECRET_ACCESS_KEY=
ALPHART_EDU_S3_FORCE_PATH_STYLE=true
